# SPDX-License-Identifier: Apache-2.0
#
# Append to /home/guardian/claw-net/Caddyfile, then:
#   sudo cp /home/guardian/claw-net/Caddyfile /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Both of those are already in guardian's NOPASSWD sudoers list, so no privilege
# change is needed for the web route itself.

radar.heyvera.org {
	reverse_proxy localhost:8402 {
		header_up X-Real-IP {remote}
		header_up X-Forwarded-For {remote}
		header_up X-Forwarded-Proto {scheme}

		# Hand each event to the client as it arrives rather than buffering the
		# response. Without this the event stream at /v1/events is collected and
		# delivered when the connection closes, which for a stream that never
		# closes means never -- and the failure looks exactly like a server that
		# is not sending anything.
		flush_interval -1
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		# One year, subdomains included, and preload-eligible.
		#
		# Caddy already redirects http to https, which closes the *second* visit
		# and every one after it. HSTS is about the **first**: a browser that has
		# never seen this host sends the initial request in clear text, and an
		# attacker on the path answers it. Everything else in this block is a
		# header telling the browser what to do with a response it already has,
		# which is no help to a request that never reached us.
		#
		# `includeSubDomains` is safe here because nothing is served under a
		# subdomain of this host. `preload` is the opt-in for the browser-shipped
		# list, and it is the half that closes the first visit for good —
		# submitting the domain is a separate step at hstspreload.org and this
		# header is its precondition.
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		# The interface is a compiled bundle served from this origin, so every
		# source is 'self' and nothing is inline. Vite emits a linked stylesheet
		# and a module script rather than inline blocks, which is what lets
		# `unsafe-inline` come out entirely -- it was there for the ops page's
		# single inline <style> and is no longer needed by anything.
		#
		# No CDN, no external font host, no third-party origin of any kind. Token
		# names are creator-supplied and are escaped before rendering; a policy
		# that admits script only from this origin means a missed escape is a
		# rendering bug rather than a compromise.
		#
		# `connect-src 'self'` covers both the JSON fetches and the EventSource.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'"
	}

	# Everything except the event stream is compressed.
	#
	# A compressed SSE response breaks in a way that is hard to attribute: the
	# encoder waits for enough bytes to be worth compressing, and a stream that
	# emits a couple of hundred bytes every ten seconds never provides them. The
	# client sees an open connection carrying nothing.
	#
	# Excluded by path rather than by content type, because the exclusion has to
	# be decided before the response exists.
	@compressible not path /v1/events
	encode @compressible zstd gzip
}
