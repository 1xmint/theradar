# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Radar bounded IEX research capture
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
DynamicUser=yes
WorkingDirectory=/
ExecStart=/usr/bin/python3 /usr/local/lib/radar-paper/record-alpaca-market.py
EnvironmentFile=/etc/radar/alpaca-paper.env
StateDirectory=radar-paper-tape
StateDirectoryMode=0700
TimeoutStartSec=45
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
MemoryMax=128M
TasksMax=16
CPUQuota=25%
