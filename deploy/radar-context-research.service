# SPDX-License-Identifier: Apache-2.0
[Unit]
Description=Radar regular-session contextual research campaign tick
After=network-online.target radar-codex.socket
Wants=network-online.target
Requires=radar-codex.socket

[Service]
Type=oneshot
User=guardian
Group=guardian
WorkingDirectory=/
ExecStart=/usr/bin/python3 /usr/local/lib/radar-context-research/run-alpaca-research.py --context-campaign
EnvironmentFile=/etc/radar/alpaca-paper.env
StateDirectory=radar-paper-context
StateDirectoryMode=0700
TimeoutStartSec=135
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LimitCORE=0
MemoryMax=128M
TasksMax=16
CPUQuota=25%
