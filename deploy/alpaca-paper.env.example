# Private operator CLI environment; do not commit real values or paste in chat.
# These are PAPER credentials, separate from Alpaca live credentials.
# Keep in a restricted file outside the checkout. Do not place broker secrets
# in radar-serve's environment: future execution needs a separate broker worker.
# This example does not install or activate any service.
RADAR_ALPACA_PAPER_KEY_ID=
RADAR_ALPACA_PAPER_SECRET_KEY=
