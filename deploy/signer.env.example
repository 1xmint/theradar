# Programs the signer will sign an instruction for, base58, comma-separated.
#
# An allowlist rather than a denylist: the set of programs that can take a token
# away from you is not enumerable, and the set that can trade one is.
#
# An empty value refuses everything. Of every misconfiguration available here,
# an empty allowlist that defaulted to permissive would be the one with no upper
# bound on its cost.
#
# JUP6LkbZbjS1jKKwapdHNy74zcZ3tLUZoi5QNyVTaV4  Jupiter v6 aggregator
# 6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P  pump.fun
# pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA  PumpSwap
# 11111111111111111111111111111111             system program (wSOL, fees)
# ComputeBudget111111111111111111111111111111  compute budget
RADAR_SIGNER_PROGRAMS=

# The policy the signer judges against, as a path to a JSON file. **Required**:
# the process refuses to start without it, and this file did not name it.
#
# ADR 0008 is why it is the signer's own and not the caller's. The caller sends
# an `Authorization` and says what it was judged against; the signer applies
# *this* policy unconditionally, before anything the caller asserted is used as
# a bound. That is what makes `Policy::CLOSED` closed at the key rather than
# closed only in the process that decides.
#
# Ship `Policy::CLOSED` until there is a measured edge to trade on. Write it out
# rather than pointing at a file somebody might edit in place:
#
#   sudo install -m 0640 -o root -g radar-signer /dev/stdin /etc/radar/policy.json <<'JSON'
#   {"autonomy":"observe","max_position":0,"max_deployed":0,"max_per_creator":0,"max_daily_loss":0,"max_round_trip_cost_bps":0,"max_canary":0,"max_input_staleness":0,"max_consecutive_failures":0}
#   JSON
#
# `autonomy: Observe` cannot self-authorise, so every request is refused with
# `AutonomyInsufficient` whatever else is in the file.
RADAR_SIGNER_POLICY=/etc/radar/policy.json

# local (default) loads RADAR_SIGNER_KEY. privy never loads a Solana key and
# refuses local signing, even if the systemd unit supplies RADAR_SIGNER_KEY.
RADAR_SIGNER_MODE=local

# Any configured Privy authorization key requires all three public bindings.
# Provision RADAR_PRIVY_AUTHORIZATION_KEY only in the isolated signer's protected
# environment, never radar-serve. Do not enable delegation until independent
# Privy policy refusals, authenticated issuance and durable accounting are proved.
RADAR_SIGNER_PRIVY_APP_ID=
RADAR_SIGNER_PRIVY_WALLET_ID=
RADAR_SIGNER_PRIVY_WALLET_ADDRESS=

# Required with a Privy key. Provision a fresh directory ONCE as radar-signer,
# mode 0700, on a persistent local filesystem. Preserve it through restarts,
# upgrades and key rotation. Never recreate or clear it to retry an intent.
# Failed/interrupted attempts require reconciliation and a NEW authorization.
RADAR_SIGNER_NONCE_DIR=/var/lib/radar-signer/nonces

# Required with a Privy key. Public Ed25519 trust anchor for the isolated issuer;
# never put its PRIVATE key in Serve, the executor, or this signer. The isolated
# kernel/reservation issuer is not implemented yet, so do not enable this lane.
RADAR_SIGNER_ISSUER_PUBLIC_KEY=

# Required positive maximum validity interval in seconds. No live default is
# chosen here. Intents carry signed issue/expiry times; the signer reads its own
# host clock before nonce reservation and again before key use. Protect host
# time: clock rollback can extend acceptance. This does not validate chain state
# or stop HTTP resubmission of a Privy signature already returned to a caller.
RADAR_SIGNER_MAX_INTENT_LIFETIME_SECS=
